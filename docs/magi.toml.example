# magi-rs configuration — reference example.
#
# This file documents EVERY available key, with the reasoning behind each one.
# `magi init` writes a shorter starting file carrying only the built-in
# defaults, so this is a reference rather than a copy of what the tool
# generates. To use Anthropic instead, set provider = "anthropic" (or
# MAGI_PROVIDER=anthropic).
#
# Copy what you need into `.magi/magi.toml` and edit. That file is gitignored;
# only `docs/magi.toml.example` is tracked.
#
# Credentials NEVER live here: they travel by env (the Anthropic and OpenAI
# credential env vars) or in the vault (`magi-rs vault set NAME`). An unknown
# field is a PARSE ERROR, and a file that exists but does not parse is FATAL.
provider = "ollama"          # ollama | openai-compat | anthropic

# System-wide DEFAULT endpoint: used by the main agent, the trio and the embedder
# unless their own section overrides it.
# Precedence per consumer: its own env var > its own section > this value > built-in.
#
# BREAKING: this key lived at [openai].base_url until v0.11.0 and NO LONGER EXISTS there.
base_url = "http://localhost:11434/v1"
#   With an authenticated endpoint, NEVER a literal credential: use placeholders that
#   resolve from the vault IN MEMORY. A literal value is a configuration error.
#     base_url = "https://[user]:[password]@host/v1"
#     magi-rs vault set BASE_URL_USER  /  magi-rs vault set BASE_URL_PASSWORD

# Bounds the consult report that enters the history. This matters most in an interactive
# session, where the report is re-sent to the model on every subsequent turn, so its cost
# is paid per turn rather than once. BREAKING: this key lived under [headless] until
# v0.11.0.
# tool_result_cap_bytes = 65536

[openai]
# Model for `ollama` AND for `openai-compat`: they share the completions protocol.
model = "kimi-k2.6:cloud"

[anthropic]
model = "claude-sonnet-4-6"

# ===========================================================================
# [magi] — the council of three perspectives
# ===========================================================================
[magi]
melchior_model  = "qwen3.5:397b-cloud"     # Scientist  — theoretical analysis
balthasar_model = "kimi-k2.6:cloud"        # Pragmatist — practical trade-offs
caspar_model    = "glm-5.2:cloud"          # Critic     — adversarial review

# When `false`, the agent asks before each autonomous launch. When `true`, it
# auto-approves and announces it. The explicit `/consult` command is never gated.
# Either way a consult costs three LLM calls.
auto_approve = false

# Declare only when the trio runs on a different backend than the main agent. Omitted
# means it INHERITS the root `provider`. Only `ollama` is measurable, because it exposes
# endpoints for context-window and weights-digest probing.
# kind = "ollama"

# Overrides the endpoint for the trio only. Commented out means it inherits the root
# value above.
# base_url = "http://remote-host:11434/v1"

# Sets the mode for invocations that do not pass `--mode`. Declaring it counts as
# declared, so the classification call is skipped: a pipeline running bulk consults
# pays zero classifications without touching its call sites. Omitted means the mode is
# inferred, which costs one extra model call. Valid values: `analysis`, `design`,
# `code-review`.
# default_mode = "analysis"

# Declare this when the consult acts as a gate over content you do not control. It
# requires the mode to be declared rather than inferred, removing the classification
# call as an injection surface.
# untrusted_content = false

# The input cap of magi-rs itself, applied before magi-core sees the payload. It rejects,
# never truncates: a silently shortened payload would produce a verdict
# indistinguishable from a legitimate one. The size is chosen by cost, not capacity,
# because the payload is sent to all three mages and therefore paid for three times.
max_query_bytes = 262144

# The per-mage timeout ceiling. The two internal timeout layers are DERIVED from this
# value and are not configurable separately, so no combination can break the relation
# between them.
agent_timeout_secs = 90

# Omitted means the threshold is MEASURED by the probe when the endpoint allows it, and
# otherwise falls back to the built-in default.
# input_warn_tokens = 150000

# Omitted keeps the retry the trio inherits from magi-core.
# retry_disabled = false

# Values are the minimum content length, in CHARACTERS, for the agent to dispatch a
# consult on its own. Characters and not bytes on purpose: a byte threshold would treat
# the same text differently depending on the language it is written in. Explicit
# `/consult` and `magi consult` are NEVER vetoed. Setting a value to `0` disables the
# veto for that mode. These thresholds are a starting point, not an empirical
# calibration.
[magi.complexity]
code_review = 200
design      = 500
analysis    = 200

[embedding]
model = "nomic-embed-text-v2-moe:latest"
dim   = 0
# Overrides the embedding endpoint. Commented out means it inherits the root `base_url`.
# BREAKING: until v0.11.0 this key always carried its own value, so it never inherited.
# base_url = "..."
