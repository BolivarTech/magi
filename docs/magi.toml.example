# magi-rs configuration — reference example.
#
# This file documents EVERY available key, with the reasoning behind each one.
# `magi init` writes a shorter starting file carrying only the built-in
# defaults, so this is a reference rather than a copy of what the tool
# generates. To use Anthropic instead, set provider = "anthropic" (or
# MAGI_PROVIDER=anthropic).
#
# Copy what you need into `.magi/magi.toml` and edit. That file is gitignored;
# only `docs/magi.toml.example` is tracked.
#
# Credentials NEVER live here: they travel by env (the Anthropic and OpenAI
# credential env vars, plus one per section that can have its own endpoint; see
# docs/keys.md) or in the vault (`magi-rs vault set NAME`). An unknown
# field is a PARSE ERROR, and a file that exists but does not parse is FATAL.
# `provider` accepts exactly three values:
#   ollama         local or remote Ollama daemon (this file's default)
#   openai-compat  any OpenAI-shaped endpoint — OpenAI, Groq, OpenRouter, vLLM, …
#   anthropic      the Anthropic Messages API (key from the env or the vault)
# Anything else is a parse error, and a magi.toml that fails to parse is fatal.
provider = "ollama"

# System-wide DEFAULT endpoint: used by the main agent, the trio and the embedder
# unless their own section overrides it.
# Precedence per consumer: its own env var > its own section > this value > built-in.
#
# BREAKING: this key lived at [openai].base_url until v0.11.0 and NO LONGER EXISTS there.
base_url = "http://localhost:11434/v1"
#   With an authenticated endpoint, NEVER a literal credential: use placeholders that
#   resolve from the vault IN MEMORY. A literal value is a configuration error.
#     base_url = "https://[user]:[password]@host/v1"
#     magi-rs vault set BASE_URL_USER  /  magi-rs vault set BASE_URL_PASSWORD

# Bounds the consult report that enters the history. This matters most in an interactive
# session, where the report is re-sent to the model on every subsequent turn, so its cost
# is paid per turn rather than once. BREAKING: this key lived under [headless] until
# v0.11.0.
# tool_result_cap_bytes = 65536

[openai]
# Model for `ollama` AND for `openai-compat`: they share the completions protocol.
model = "kimi-k2.6:cloud"

[anthropic]
model = "claude-sonnet-4-6"

# ===========================================================================
# [decision] — typed decisions from System One models (`magi decide`)
# ===========================================================================
[decision]
# Endpoint of the System One decision models. Optional: absent = the root `base_url`.
# The protocol path is derived from it: a base_url ending in /v1 gets /systemone, any other gets /v1/systemone.
base_url     = "http://localhost:11434"
# Primary decision model. Required in this section.
model        = "clef-flash"
# Per-attempt timeout in seconds (covers a local cold load). Optional, default 120.
# `clef-flash` loaded in 16.5 s on an idle machine and 49.4 s on a busy one (RTX 5060 Ti, 16 GB),
# so it needs at least 66 s here. Inside one consult the chain can take about 135 s: this timeout
# for `clef-flash` plus the 14.3 s cold load of `nimble`. Numbers from other hardware will differ.
timeout_secs = 120
# Ollama only. Optional: absent = not sent (server default). "10m", "2h", or -1 (keep loaded).
# keep_alive = "10m"
# Approval of the agent's `decide` tool. Optional, default true.
auto_approve = true
# Largest consult, in bytes, whose mode is inferred with `decide`; larger consults go straight
# to the main model. 61000 fits the request-size cap measured with the local `clef-flash` model. With a hosted decision
# model such as typesafe/jev-1.13, raise it or delete the line (built-in default 128000).
max_state_bytes = 61000
# Below this confidence the answer is discarded and the next model in the chain is tried. When the
# chain is exhausted, internal decisions fall back to the LLM and explicit calls return an error.
# Optional, per model; commenting it out disables the threshold (the top option is always taken).
# The value below comes from the maintainer's own calibration and may not fit your data or use
# case: measure on yours before relying on it.
min_confidence = 0.75

# Ordered fallbacks on the SAME endpoint, tried after the primary fails.
[[decision.fallback]]
model = "nimble"
min_confidence = 0.75

# --- Example: OpenRouter (hosted). Needs the decision key (see docs/decide.md) in the environment or
# --- in the vault (`magi-rs vault set`). The key never goes in this file.
# --- Comment out the [decision] section above before uncommenting this one: a file holds one.
# [decision]
# base_url     = "https://openrouter.ai/api/v1"
# model        = "typesafe/jev-1.13"
# timeout_secs = 30
#
# [[decision.fallback]]
# model = "togethercomputer/tev1-4b-experimental"
#
# [[decision.fallback]]
# model = "upstage/solar-decide"

# ===========================================================================
# [magi] — the council of three perspectives
# ===========================================================================
[magi]
melchior_model  = "glm-5.3:cloud"          # Scientist  — theoretical analysis
balthasar_model = "kimi-k2.6:cloud"        # Pragmatist — practical trade-offs
caspar_model    = "deepseek-v4-pro:cloud"  # Critic     — adversarial review

# BREAKING (v0.13.0): a seat that declares a model MUST declare its lineage — the independent
# failure domain that model belongs to. It is never inferred from the tag: the same two models can
# legitimately be two lineages for one user and one for another, and this label is what decides
# every rotation. A file from v0.12.0 fails to start until these three lines exist, and the error
# names all three at once. A seat left on the built-in model inherits the built-in lineage and owes
# nothing.
melchior_lineage  = "zhipu"
balthasar_lineage = "moonshot"
caspar_lineage    = "deepseek"

# When `false`, the agent asks before each autonomous launch. When `true`, it
# auto-approves and announces it. The explicit `/consult` command is never gated.
# Either way a consult costs three LLM calls.
auto_approve = false

# Declare only when the trio runs on a different backend than the main agent. Omitted
# means it INHERITS the root `provider`. Only `ollama` is measurable, because it exposes
# endpoints for context-window and weights-digest probing.
# kind = "ollama"

# Overrides the endpoint for the trio only. Commented out means it inherits the root
# value above.
# base_url = "http://remote-host:11434/v1"

# Key for the trio: it has its own environment variable and vault entry, named in
# docs/keys.md, and it never goes in this file. Without one, an `openai-compat` trio reuses the
# main model's OpenAI-compatible key only when this section's endpoint has the same origin
# (scheme, host and port; the path does not count) as the root one, and otherwise sends no key.
# A gateway that routes by path is one origin and receives the main key; declare the trio's own
# key to avoid that. With kind = "anthropic" the seats use the trio's own key if set and the
# Anthropic key otherwise. The trio's key must be a key for the provider of `kind`. Startup warns
# (a warning only; nothing is blocked) when an `anthropic` trio has a key without Anthropic's documented
# prefix or any other kind has a key with it. That is the only shape check: two
# OpenAI-compatible providers cannot be told apart, so an OpenRouter-style key on
# `openai-compat` gives no warning, while an unprefixed key on `anthropic` does.

# Sets the mode for invocations that do not pass `--mode`. Declaring it counts as
# declared, so the classification call is skipped: a pipeline running bulk consults
# pays zero classifications without touching its call sites. Omitted means the mode is
# inferred, which costs one extra model call. Valid values: `analysis`, `design`,
# `code-review`.
# default_mode = "analysis"

# Declare this when the consult acts as a gate over content you do not control. It
# requires the mode to be declared rather than inferred, removing the classification
# call as an injection surface.
# untrusted_content = false

# The input cap of magi-rs itself, applied before magi-core sees the payload. It rejects,
# never truncates: a silently shortened payload would produce a verdict
# indistinguishable from a legitimate one. The size is chosen by cost, not capacity,
# because the payload is sent to all three mages and therefore paid for three times.
max_query_bytes = 262144

# The per-mage timeout ceiling. The two internal timeout layers are DERIVED from this
# value and are not configurable separately, so no combination can break the relation
# between them. The default (2335, as of v0.21.0) derives a 700 s per-request client
# timeout and a 1401 s operation budget — sized to cover the shipped trio's measured
# convergence, not the full max_tokens cap at the 55 tok/s reference speed. Setting
# this back to 90 restores v0.20.0's clock exactly.
agent_timeout_secs = 2335

# Omitted means the threshold is MEASURED by the probe when the endpoint allows it, and
# otherwise falls back to the built-in default.
# input_warn_tokens = 150000

# Omitted keeps the retry the trio inherits from magi-core.
# retry_disabled = false

# Values are the minimum content length, in CHARACTERS, for the agent to dispatch a
# consult on its own. Characters and not bytes on purpose: a byte threshold would treat
# the same text differently depending on the language it is written in. Explicit
# `/consult` and `magi consult` are NEVER vetoed. Setting a value to `0` disables the
# veto for that mode. These thresholds are a starting point, not an empirical
# calibration.
# ── Rotation (v0.13.0) ─────────────────────────────────────────────────────────
# How many times ONE mage may rotate to a fallback before its run degrades. `0` is a
# kill-switch that restores v0.12.0 behaviour EXACTLY — no rotation, and the same
# `--timeout` the formula produced before rotation existed.
#
# It is a multiplier on the worst case, and the headless `--timeout` default is derived
# from it: `attempts x (1 + max_rotations) x agent_timeout_secs`, plus slack. With the
# defaults that is ~11 minutes, which is only ever paid when something is genuinely hung.
# For a hard cap in CI, pass `--timeout` and take the warning naming the computed minimum.
# max_rotations = 2

# Refuse fallback candidates whose context window could not be measured.
#
# Default `false`, and the case it would bite is the COLD START: a daemon that has not
# loaded a model yet does not answer the probe in time, so on a first run NOTHING is
# measured — and with the guard on, every candidate would be rejected and rotation would
# switch off entirely. magi-rs therefore passes it down ONLY when at least one candidate
# has a measured window, and announces it when it declines to.
# strict_context_guard = false

# Require the three seats to declare DIFFERENT lineages.
#
# Default `true`: lineage diversity is what a rotation buys, so the system asks for it and
# whoever cannot supply it turns the check off deliberately rather than discovering later
# that the safety net was never real. If you only have models from one vendor, either
# declare finer labels — by model family, e.g. opus/sonnet/haiku, which gives you real
# rotation — or set:
# enforce_diversity = false

# Reasoning control for the whole trio (applies to all three seats — magi-core
# declined a per-seat override). "default" says nothing and the backend's own
# behaviour applies; "disabled" asks it to skip its reasoning channel; "enabled"
# forces the channel on. Measured 2026-09-23: turning reasoning off lost 20-48% of
# detection at every cap tested, so it is not recommended for a review gate even
# though it terminates faster.
# reasoning = "default"  # "default" | "disabled" | "enabled"

# Output cap per completion, per seat, in tokens — billed as completion tokens
# on every attempt. At roughly 55 tok/s a full cap can take minutes; raise
# agent_timeout_secs (or --timeout on the headless path) before raising this. A
# value above the pinned model's own output maximum returns HTTP 400.
# max_tokens = 65536  # tokens; no upper bound of magi-rs's own

# Opt-in: for cut attempts (finish = length or empty content) the log gets a
# bounded head and tail of the reasoning trace, file only, off by default. The
# trace is untrusted model text: a credential shorter than 32 characters that was
# never registered with magi-rs and that the model echoes can still reach the log
# unmasked.
# reasoning_trace = false

# Only sent to openai-compat seats; no default. Accepted: effort-none,
# effort-minimal, reasoning-enabled-object. A spelling the pinned model rejects
# returns HTTP 400, and magi-core treats a 400 as lineage-condemning: all three seats
# of that lineage are lost for the run. Verify against the pinned model first, and
# again after any provider-side model update.
# reasoning_spelling = "effort-none"  # (no default)

[magi.complexity]
code_review = 200
design      = 500
analysis    = 200

[embedding]
model = "nomic-embed-text-v2-moe:latest"
dim   = 0
# Overrides the embedding endpoint. Commented out means it inherits the root `base_url`.
# BREAKING: until v0.11.0 this key always carried its own value, so it never inherited.
# base_url = "..."
# Key for the embedder: it has its own environment variable and vault entry, named in
# docs/keys.md. Without one, the main model's OpenAI-compatible key is used only when this
# section's endpoint has the same origin as the root one; on any other origin no key is sent
# and an endpoint that wants one answers 401 or 403.

[logging]
# Where the daily files live. Relative paths resolve against the workspace root.
log_dir = ".magi/logs"
# What the FILE branch writes. A bare level, or a comma-separated list of
# `target=level` directives with a bare level as the default:
#   file_filter = "magi_rs=debug,magi_core=warn,error"
# The longest matching target wins, so a general rule and a specific one compose.
# A crate name written with dashes matches the module path with underscores.
# An unknown level word is a load error, never a silent fallback to `info`.
file_filter = "info"
# Whether a rotated file is compressed to `.xz`.
compress = true
# Age in days past which a rotated file is compressed.
compress_after_days = 2
# Age in days past which a file is deleted. Counts DAYS -- the retired
# `[headless].log_retention` counted RUNS, and there is no conversion between them.
retain_days = 30
# Ceiling on the whole directory, in bytes. 512 MiB. The oldest go first.
max_total_bytes = 536870912

# ── The rotation pool goes LAST IN THE FILE ────────────────────────────────────
# Not "last in the [magi] block": in TOML every loose key and sub-table must precede the
# first array of tables, so a key added to [magi] later could land after this array and
# parse into the wrong table. "Last in the file" leaves nowhere to get it wrong — which
# is why [embedding] above sits before it.
#
# Ordered STRONGEST to WEAKEST: the order is the rotation preference. It is a SHARED pool,
# not one list per seat — what consensus needs is that a rotation lands on a lineage the
# other two seats do not hold, and that is a property of the pool's diversity rather than
# of who owns the list.
#
# A candidate whose lineage NO seat has covers all three seats. One that shares a seat's
# lineage covers only that seat, because the other two still hold their own lineage in
# play while it rotates.
[[magi.fallback]]
model   = "minimax-m3:cloud"
lineage = "minimax"

[[magi.fallback]]
model   = "nemotron-3-super:cloud"
lineage = "nvidia"

[[magi.fallback]]
model   = "gpt-oss:120b-cloud"
lineage = "openai"

[[magi.fallback]]
model   = "mistral-large-3:675b-cloud"
lineage = "mistral"

[[magi.fallback]]
model   = "gemma4:cloud"
lineage = "google"
